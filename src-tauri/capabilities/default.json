{
    "$schema": "https://schema.tauri.app/capabilities/2",
    "identifier": "default",
    "description": "Core file system and dialog permissions",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:event:allow-listen",
        "core:event:allow-emit",
        "core:window:default",
        "core:window:allow-destroy",
        "core:window:allow-close",
        "dialog:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "fs:default",
        "fs:allow-appdata-read-recursive",
        "fs:allow-appdata-write-recursive",
        "fs:allow-appdata-meta-recursive",
        "fs:create-app-specific-dirs",
        "shell:allow-open"
    ]
}